# S3 bucket where Polly stages synthesised audio. Required for audio generation.
ORATOR_S3_BUCKET=

# AWS region. London has full Polly neural and Translate coverage.
ORATOR_AWS_REGION=eu-west-2

# Optional, local development only. Name of the AWS profile to use when the
# machine has more than one account configured. Leave empty in deployment,
# where the IAM role attached to the compute provides credentials.
ORATOR_AWS_PROFILE=

# Origin allowed by CORS, the address the frontend dev server runs on.
ORATOR_CORS_ORIGIN=http://localhost:5173

# SQLAlchemy database URL. The default is a local SQLite file in the repo root.
ORATOR_DATABASE_URL=sqlite:///orator.db

# Directory for uploaded documents and generated audio.
ORATOR_MEDIA_DIR=media
